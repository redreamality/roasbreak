{
  "name": "roas-break",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-og.mjs && node scripts/generate-sitemap.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:content": "node scripts/check-content.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:check:verify": "node scripts/release-check.mjs --no-write",
    "review:check": "node scripts/check-content-reviews.mjs",
    "production:smoke": "node scripts/production-smoke.mjs",
    "production:smoke:browser": "node scripts/production-smoke.mjs --browser",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm test && pnpm release:check:verify && pnpm review:check && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "lucide": "^1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
